diff --git a/android/aosp/sepolicy/product/private/peridot_daemon.te b/android/aosp/sepolicy/product/private/peridot_daemon.te
new file mode 100644
index 0000000..c56f7bb
--- /dev/null
+++ b/android/aosp/sepolicy/product/private/peridot_daemon.te
@@ -0,0 +1,65 @@
+init_daemon_domain(peridot_daemon)
+
+# peridot_app carries Android's per-user MCS categories while an init daemon
+# runs at s0. Trust only the daemon endpoint so the MLS socket constraint can
+# pass; the explicit connectto rule below remains the sole client allowlist.
+typeattribute peridot_daemon mlstrustedsubject;
+
+# Declared by the reviewed platform exception described in ROM_INTEGRATION.md.
+# The preserved native THP backend requires cross-UID access to the touch HAL.
+typeattribute peridot_daemon peridot_native_touch_access;
+
+type peridot_daemon_data_file, file_type, data_file_type, core_data_file_type;
+
+allow peridot_daemon self:capability {
+    dac_override
+    sys_admin
+    sys_nice
+    sys_ptrace
+};
+allow peridot_daemon self:unix_stream_socket create_stream_socket_perms;
+# Cable changes are delivered by the kernel power-supply uevent channel. The
+# daemon uses it only to restore a fixed charging profile after reconnecting;
+# it does not poll or monitor other processes.
+allow peridot_daemon self:netlink_kobject_uevent_socket {
+    create
+    bind
+    read
+    getattr
+    getopt
+    setopt
+};
+
+allow peridot_daemon peridot_daemon_data_file:dir create_dir_perms;
+allow peridot_daemon peridot_daemon_data_file:file create_file_perms;
+
+# The UI is the only production client allowed to control the daemon.
+allow peridot_app peridot_daemon:unix_stream_socket connectto;
+
+# Keep the command-line health client available on development builds only.
+userdebug_or_eng(`
+    allow shell peridot_daemon:unix_stream_socket connectto;
+')
+
+binder_use(peridot_daemon)
+binder_call(peridot_daemon, system_server)
+# Framework command clients pass their output pipe to system_server. Permit
+# only that reply direction; without it `cmd window`, `cmd settings`, and
+# `dumpsys` can remain blocked even though the Binder call itself is allowed.
+allow system_server peridot_daemon:fd use;
+allow system_server peridot_daemon:fifo_file write;
+allow peridot_daemon display_service:service_manager find;
+allow peridot_daemon power_service:service_manager find;
+allow peridot_daemon settings_service:service_manager find;
+allow peridot_daemon window_service:service_manager find;
+# System Colors resolves the foreground user and reads native palette output.
+# SettingsProvider and SystemUI retain ownership of the actual theme overlays.
+allow peridot_daemon activity_service:service_manager find;
+allow peridot_daemon package_service:service_manager find;
+# Per-App Controls listens to activity events rather than polling full dumps.
+read_logd(peridot_daemon)
+allow peridot_daemon overlay_service:service_manager find;
+
+# The backend calls Android command-line clients for settings and diagnostics.
+allow peridot_daemon system_file:file { rx_file_perms execute_no_trans };
+allow peridot_daemon toolbox_exec:file { rx_file_perms execute_no_trans };
