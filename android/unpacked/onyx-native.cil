; Peridot Essential offline image integration. Merge into a loaded policy file.
; This fragment requires the Xiaomi Peridot vendor labels; compile the full ROM.
(type peridot_daemon)
(type peridot_daemon_exec)
(type peridot_daemon_data_file)
(type peridot_app)
(type peridot_app_userfaultfd)
(typeattribute peridot_app_userfaultfd_others)
(typeattribute peridot_app_ptrace_forbidden)
(type sysfs_peridot_mali_devfreq)
(type sysfs_peridot_touch)
(type sysfs_peridot_subsystem)
(type sysfs_peridot_subsystem_floor)
(roletype object_r peridot_daemon)
(roletype object_r peridot_daemon_exec)
(roletype object_r peridot_daemon_data_file)
(roletype object_r peridot_app)
(roletype object_r peridot_app_userfaultfd)
(roletype object_r sysfs_peridot_mali_devfreq)
(roletype object_r sysfs_peridot_touch)
(roletype object_r sysfs_peridot_subsystem)
(roletype object_r sysfs_peridot_subsystem_floor)
(typeattributeset domain (peridot_daemon peridot_app))
(typeattributeset coredomain (peridot_daemon peridot_app))
(typeattributeset mlstrustedsubject (peridot_daemon))
(typeattributeset appdomain (peridot_app))
(typeattributeset untrusted_app_all (peridot_app))
(typeattributeset netdomain (peridot_app))
(typeattributeset exec_type (peridot_daemon_exec))
(typeattributeset file_type (peridot_daemon_exec peridot_daemon_data_file))
(typeattributeset system_file_type (peridot_daemon_exec))
(typeattributeset data_file_type (peridot_daemon_data_file))
(typeattributeset core_data_file_type (peridot_daemon_data_file))
(typeattributeset fs_type (sysfs_peridot_mali_devfreq sysfs_peridot_touch))
(typeattributeset sysfs_type (sysfs_peridot_mali_devfreq sysfs_peridot_touch))
(typeattributeset fs_type (sysfs_peridot_subsystem sysfs_peridot_subsystem_floor))
(typeattributeset sysfs_type (sysfs_peridot_subsystem sysfs_peridot_subsystem_floor))

; Equivalent app_domain essentials; Android's existing app rules still apply.
(typetransition peridot_app tmpfs file appdomain_tmpfs)
(allow peridot_app appdomain_tmpfs (file (execute getattr map read write ioctl)))
(allowx peridot_app appdomain_tmpfs (ioctl file ((range 0x7701 0x770b))))
(typetransition peridot_app peridot_app anon_inode "[userfaultfd]" peridot_app_userfaultfd)
(allow peridot_app peridot_app_userfaultfd (anon_inode (create ioctl read)))
(typeattributeset peridot_app_userfaultfd_others (and (domain) (not (peridot_app))))
(typeattributeset peridot_app_ptrace_forbidden (and (domain) (not (peridot_app crash_dump runas_app simpleperf))))
(neverallow peridot_app_userfaultfd_others peridot_app_userfaultfd (anon_inode (create ioctl read)))
(neverallow peridot_app_ptrace_forbidden peridot_app (process (ptrace)))

; Init startup, owned state and the certificate-bound app control socket.
(typetransition init peridot_daemon_exec process peridot_daemon)
(allow init peridot_daemon (process (transition rlimitinh siginh)))
(allow init peridot_daemon_exec (file (getattr open read execute map)))
(allow peridot_daemon peridot_daemon_exec (file (entrypoint getattr open read execute map)))
(allow peridot_app peridot_daemon (unix_stream_socket (connectto)))
(allow peridot_daemon self (unix_stream_socket (ioctl read write create getattr setattr lock append bind connect listen accept getopt setopt shutdown)))
(allow peridot_daemon self (capability (dac_override sys_admin sys_nice sys_ptrace)))
(allow peridot_daemon self (netlink_kobject_uevent_socket (create bind read getattr getopt setopt)))
(allow peridot_daemon peridot_daemon_data_file (dir (ioctl read write create getattr setattr lock rename add_name remove_name reparent search open rmdir)))
(allow peridot_daemon peridot_daemon_data_file (file (ioctl read write create getattr setattr lock append map unlink link rename open)))

; Framework commands, including output pipe/FD replies.
(allow peridot_daemon servicemanager (binder (call transfer)))
(allow servicemanager peridot_daemon (binder (call transfer)))
(allow servicemanager peridot_daemon (dir (search)))
(allow servicemanager peridot_daemon (file (read open)))
(allow servicemanager peridot_daemon (process (getattr)))
(allow peridot_daemon system_server (binder (call transfer)))
(allow system_server peridot_daemon (binder (transfer)))
(allow peridot_daemon system_server (fd (use)))
(allow system_server peridot_daemon (fd (use)))
(allow system_server peridot_daemon (fifo_file (write)))
(allow peridot_daemon display_service (service_manager (find)))
(allow peridot_daemon power_service (service_manager (find)))
(allow peridot_daemon settings_service (service_manager (find)))
(allow peridot_daemon window_service (service_manager (find)))
(allow peridot_daemon activity_service (service_manager (find)))
(allow peridot_daemon package_service (service_manager (find)))
; Passive foreground event stream for Per-App Controls.
(allow peridot_daemon logd (unix_stream_socket (connectto)))
(allow peridot_daemon logdr_socket (sock_file (read write open getattr)))
(allow peridot_daemon overlay_service (service_manager (find)))
(allow peridot_daemon system_file (file (getattr open read execute map execute_no_trans)))
(allow peridot_daemon toolbox_exec (file (getattr open read execute map execute_no_trans)))

; Hardware nodes. No generic sysfs file write permission.
(allow peridot_daemon sysfs (dir (search)))
; Battery class links need parent traversal before leaf permissions apply.
; No sysfs_batteryinfo file access is granted.
(allow peridot_daemon sysfs_batteryinfo (dir (search)))
(allow peridot_daemon sysfs_devices_system_cpu (dir (search getattr open read)))
(allow peridot_daemon sysfs_devices_system_cpu (file (read write getattr open ioctl lock map)))
(allow peridot_daemon sysfs_devices_block (dir (search getattr open read)))
(allow peridot_daemon sysfs_devices_block (file (read write getattr open ioctl lock map)))
(allow peridot_daemon sysfs_memory (dir (search getattr open read)))
(allow peridot_daemon sysfs_memory (file (read write getattr open ioctl lock map)))
(allow peridot_daemon sysfs_ged (dir (search getattr open read)))
(allow peridot_daemon sysfs_ged (file (read write getattr open ioctl lock map)))
(allow peridot_daemon sysfs_mali_power_policy (dir (search getattr open read)))
(allow peridot_daemon sysfs_mali_power_policy (file (read write getattr open ioctl lock map)))
(allow peridot_daemon sysfs_therm (dir (search getattr open read)))
(allow peridot_daemon sysfs_therm (file (read write getattr open ioctl lock map)))
(allow peridot_daemon sysfs_usb_supply (dir (search getattr open read)))
(allow peridot_daemon sysfs_usb_supply (file (read write getattr open ioctl lock map)))
(allow peridot_daemon sysfs_battery_supply (dir (search getattr open read)))
(allow peridot_daemon sysfs_battery_supply (file (read write getattr open ioctl lock map)))
(allow peridot_daemon sysfs_zram (dir (search getattr open read)))
(allow peridot_daemon sysfs_zram (file (read write getattr open ioctl lock map)))
(allow peridot_daemon sysfs_fs_f2fs (dir (search getattr open read)))
(allow peridot_daemon sysfs_fs_f2fs (file (read write getattr open ioctl lock map)))
(allow peridot_daemon sysfs_blockio (dir (search getattr open read)))
(allow peridot_daemon sysfs_blockio (file (read write getattr open ioctl lock map)))
; Screen-state detection has a framework power-service fallback. Do not grant
; coredomain access to generic LED files, forbidden by the stock platform.
(allow peridot_daemon vendor_sysfs_displayfeature (dir (search getattr open read)))
(allow peridot_daemon vendor_sysfs_displayfeature (file (read getattr open ioctl lock map)))
(allow peridot_daemon proc_powerhal_cpu_ctrl (file (read write getattr open ioctl lock map)))
(allow peridot_daemon proc_touch_boost (file (read write getattr open ioctl lock map)))
(allow peridot_daemon proc_tp_file (file (read getattr open ioctl lock map)))
(allow peridot_daemon proc_swappiness (file (read write getattr open ioctl lock map)))
(allow peridot_daemon proc_drop_caches (file (write open getattr)))
(allow peridot_daemon input_device (chr_file (read write getattr open ioctl lock map)))
(allow peridot_daemon swap_block_device (blk_file (read write getattr open ioctl lock map)))
(allow peridot_daemon sysfs_peridot_mali_devfreq (dir (search getattr open read)))
(allow peridot_daemon sysfs_peridot_mali_devfreq (file (read write getattr open ioctl lock map)))
(allow peridot_daemon sysfs_peridot_touch (dir (search getattr open read)))
(allow peridot_daemon sysfs_peridot_touch (file (read write getattr open ioctl lock map)))
(genfscon sysfs "/devices/platform/soc/13000000.mali/devfreq/13000000.mali" (u object_r sysfs_peridot_mali_devfreq ((s0) (s0))))
(genfscon sysfs "/devices/platform/13000000.mali/devfreq/13000000.mali" (u object_r sysfs_peridot_mali_devfreq ((s0) (s0))))
(genfscon sysfs "/devices/platform/goodix_ts.0" (u object_r sysfs_peridot_touch ((s0) (s0))))

; Subsystem metadata is read-only; requests are confined to min_freq/max_freq.
(allow peridot_daemon sysfs_peridot_subsystem (dir (search getattr open read)))
(allow peridot_daemon sysfs_peridot_subsystem (file (read getattr open)))
(allow peridot_daemon sysfs_peridot_subsystem_floor (file (read write getattr open)))
; Preserve the target ROM's RAM parent label and existing controller access.
(allow peridot_daemon sysfs_dvfsrc_devfreq (dir (search getattr open read)))
(allow peridot_daemon sysfs_dvfsrc_devfreq (file (read getattr open)))
(allow mtk_hal_power sysfs_peridot_subsystem (dir (ioctl read getattr lock open watch watch_reads search)))
(allow mtk_hal_power sysfs_peridot_subsystem (file (ioctl read write getattr lock append map open watch watch_reads)))
(allow mtk_hal_power sysfs_peridot_subsystem_floor (file (ioctl read write getattr lock append map open watch watch_reads)))
(genfscon sysfs "/devices/platform/soc/1c00f000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/min_freq" (u object_r sysfs_peridot_subsystem_floor ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/1c00f000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/max_freq" (u object_r sysfs_peridot_subsystem_floor ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/112b0000.ufshci/devfreq/112b0000.ufshci" (u object_r sysfs_peridot_subsystem ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/112b0000.ufshci/devfreq/112b0000.ufshci/min_freq" (u object_r sysfs_peridot_subsystem_floor ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/112b0000.ufshci/devfreq/112b0000.ufshci/max_freq" (u object_r sysfs_peridot_subsystem_floor ((s0) (s0))))

; Xiaomi vendor services and narrowly scoped native THP timing access.
(allow peridot_daemon vendor_hal_displayfeature_xiaomi_service (service_manager (find)))
(allow peridot_daemon vendor_hal_displayfeature_xiaomi_default (binder (call transfer)))
(allow vendor_hal_displayfeature_xiaomi_default peridot_daemon (binder (transfer)))
(allow peridot_daemon vendor_hal_displayfeature_xiaomi_default (fd (use)))
(allow peridot_daemon hal_touchfeature_xiaomi_service (service_manager (find)))
(allow peridot_daemon hal_touchfeature_xiaomi_default (binder (call transfer)))
(allow hal_touchfeature_xiaomi_default peridot_daemon (binder (transfer)))
(allow peridot_daemon hal_touchfeature_xiaomi_default (fd (use)))
(allow peridot_daemon hal_touchfeature_xiaomi_default (process (ptrace)))
(allow peridot_daemon hal_touchfeature_xiaomi_default (dir (search)))
(allow peridot_daemon hal_touchfeature_xiaomi_default (file (getattr open read write)))
