# KGSL devfreq appears below /sys/class/kgsl on Peridot.
genfscon sysfs "/sys/class/kgsl/kgsl-3d0/devfreq" u:object_r:sysfs_peridot_gpu_devfreq:s0
genfscon sysfs "/sys/class/kgsl/kgsl-3d0" u:object_r:sysfs_peridot_gpu_devfreq:s0

# Goodix fallback used when a port omits Xiaomi's TouchFeature service.
genfscon sysfs /devices/platform/goodix_ts.0 u:object_r:sysfs_peridot_touch:s0

# Memory: QCOM DCVS (/sys/devices/system/cpu/bus_dcvs). Parent tree stays
# read-only metadata; each rail's boost_freq floor request is the writable leaf.
genfscon sysfs /devices/system/cpu/bus_dcvs u:object_r:sysfs_peridot_subsystem:s0
genfscon sysfs /devices/system/cpu/bus_dcvs/ddr/boost_freq u:object_r:sysfs_peridot_subsystem_floor:s0
genfscon sysfs /devices/system/cpu/bus_dcvs/l3/boost_freq u:object_r:sysfs_peridot_subsystem_floor:s0
genfscon sysfs /devices/system/cpu/bus_dcvs/llcc/boost_freq u:object_r:sysfs_peridot_subsystem_floor:s0
genfscon sysfs /devices/system/cpu/bus_dcvs/ddrqos/boost_freq u:object_r:sysfs_peridot_subsystem_floor:s0
# Storage: peridot's UFS controller is ufshc@1d84000. Metadata is read-only,
# min_freq/max_freq are the writable floor/ceiling requests.
genfscon sysfs /devices/platform/soc/1d84000.ufshc/devfreq/1d84000.ufshc u:object_r:sysfs_peridot_subsystem:s0
genfscon sysfs /devices/platform/soc/1d84000.ufshc/devfreq/1d84000.ufshc/min_freq u:object_r:sysfs_peridot_subsystem_floor:s0
genfscon sysfs /devices/platform/soc/1d84000.ufshc/devfreq/1d84000.ufshc/max_freq u:object_r:sysfs_peridot_subsystem_floor:s0
