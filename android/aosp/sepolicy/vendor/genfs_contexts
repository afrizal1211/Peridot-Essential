# KGSL devfreq appears below /sys/class/kgsl on Peridot.
genfscon sysfs "/sys/class/kgsl/kgsl-3d0/devfreq" u:object_r:sysfs_peridot_gpu_devfreq:s0
genfscon sysfs "/sys/class/kgsl/kgsl-3d0" u:object_r:sysfs_peridot_gpu_devfreq:s0

# Goodix fallback used when a port omits Xiaomi's TouchFeature service.
genfscon sysfs /devices/platform/goodix_ts.0 u:object_r:sysfs_peridot_touch:s0

# Memory/storage: metadata is read-only, only min_freq/max_freq are writable.
# Keep the ROM's sysfs_dvfsrc_devfreq parent label and PowerHAL ownership.
genfscon sysfs /devices/platform/soc/1c00f000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/min_freq u:object_r:sysfs_peridot_subsystem_floor:s0
genfscon sysfs /devices/platform/soc/1c00f000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/max_freq u:object_r:sysfs_peridot_subsystem_floor:s0
genfscon sysfs /devices/platform/soc/112b0000.ufshci/devfreq/112b0000.ufshci u:object_r:sysfs_peridot_subsystem:s0
genfscon sysfs /devices/platform/soc/112b0000.ufshci/devfreq/112b0000.ufshci/min_freq u:object_r:sysfs_peridot_subsystem_floor:s0
genfscon sysfs /devices/platform/soc/112b0000.ufshci/devfreq/112b0000.ufshci/max_freq u:object_r:sysfs_peridot_subsystem_floor:s0
