(allow peridot_daemon_release_probe self (capability
    (dac_override sys_admin sys_nice sys_ptrace)))
(allow peridot_daemon_release_probe self (unix_stream_socket
    (create ioctl read getattr write setattr lock append bind connect listen
     accept getopt setopt shutdown map)))
(allow peridot_daemon_release_probe self (netlink_kobject_uevent_socket
    (create bind read getattr getopt setopt)))

(allow peridot_daemon_release_probe peridot_daemon_data_release_probe
    (dir (add_name create getattr ioctl lock open read remove_name search
          setattr write)))
(allow peridot_daemon_release_probe peridot_daemon_data_release_probe
    (file (append create getattr ioctl lock map open read rename setattr unlink
           write)))

(allow peridot_app_release_probe peridot_daemon_release_probe
    (unix_stream_socket (connectto)))

(allow peridot_daemon_release_probe sysfs (dir (search)))
(allow peridot_daemon_release_probe peridot_mali_devfreq_release_probe (dir (getattr search open read)))
(allow peridot_daemon_release_probe peridot_mali_devfreq_release_probe (file (getattr open read write ioctl lock map)))
(allow peridot_daemon_release_probe peridot_battery_supply_release_probe (file (getattr open read write ioctl lock map)))

(allow peridot_daemon_release_probe peridot_sysfs_rw_release_probe
    (dir (getattr open read search)))
(allow peridot_daemon_release_probe peridot_sysfs_rw_release_probe
    (file (getattr ioctl lock map open read write)))
(allow peridot_daemon_release_probe peridot_proc_rw_release_probe
    (file (getattr ioctl lock map open read write)))
(allow peridot_daemon_release_probe peridot_swap_block_release_probe
    (blk_file (getattr ioctl lock map open read write)))
(allow peridot_daemon_release_probe peridot_input_device_release_probe
    (chr_file (getattr ioctl lock map open read write)))

(allow peridot_daemon_release_probe peridot_touch_hal_release_probe
    (binder (call transfer)))
(allow peridot_touch_hal_release_probe peridot_daemon_release_probe
    (binder (transfer)))
(allow peridot_daemon_release_probe peridot_touch_hal_release_probe (fd (use)))
(allow peridot_daemon_release_probe peridot_touch_hal_release_probe (process (ptrace)))
(allow peridot_daemon_release_probe peridot_touch_hal_release_probe (dir (search)))
(allow peridot_daemon_release_probe peridot_touch_hal_release_probe (file (getattr open read write)))

(allow peridot_daemon_release_probe peridot_display_hal_release_probe
    (binder (call transfer)))
(allow peridot_display_hal_release_probe peridot_daemon_release_probe
    (binder (transfer)))
(allow peridot_daemon_release_probe peridot_display_hal_release_probe (fd (use)))
(allow peridot_daemon_release_probe peridot_hal_service_release_probe
    (service_manager (find)))

(allow peridot_daemon_release_probe system_server (binder (call transfer)))
(allow system_server peridot_daemon_release_probe (binder (transfer)))
(allow peridot_daemon_release_probe system_server (fd (use)))
(allow system_server peridot_daemon_release_probe (fd (use)))
(allow system_server peridot_daemon_release_probe (fifo_file (write)))
(allow peridot_daemon_release_probe display_service (service_manager (find)))
(allow peridot_daemon_release_probe power_service (service_manager (find)))
(allow peridot_daemon_release_probe settings_service (service_manager (find)))
(allow peridot_daemon_release_probe window_service (service_manager (find)))
(allow peridot_daemon_release_probe activity_service (service_manager (find)))
(allow peridot_daemon_release_probe package_service (service_manager (find)))
(allow peridot_daemon_release_probe logd (unix_stream_socket (connectto)))
(allow peridot_daemon_release_probe logdr_socket (sock_file (write)))
(allow peridot_daemon_release_probe overlay_service (service_manager (find)))
(allow peridot_daemon_release_probe system_file
    (file (execute execute_no_trans getattr map open read)))
(allow peridot_daemon_release_probe toolbox_exec
    (file (execute execute_no_trans getattr map open read)))
